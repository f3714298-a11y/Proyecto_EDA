# -----------------------------------------------------
# 9.4 Comparación exportaciones e importaciones
# -----------------------------------------------------


comercio_linea <- datos %>%
  select(
    Fecha,
    exportaciones,
    importaciones
  ) %>%
  pivot_longer(
