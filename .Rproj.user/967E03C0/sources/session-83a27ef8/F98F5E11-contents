# -----------------------------------------------------
# 10.3 Promedio móvil de exportaciones
# -----------------------------------------------------


datos <- datos %>%
  mutate(
    exportaciones_media12 =
      rollmean(
        exportaciones,
        12,
        fill=NA,
        align="right"
      )
  )



grafico_promedio_movil <- ggplot(
  datos,
  aes(x=Fecha)
)+
