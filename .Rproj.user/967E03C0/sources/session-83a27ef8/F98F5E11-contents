# =====================================================
# 1. CARGA DE LIBRERÍAS
# =====================================================

library(tidyverse)
library(readxl)
library(skimr)
library(zoo)
library(patchwork)



# =====================================================
# 2. IMPORTACIÓN DE DATOS
# =====================================================


exp <- read_excel("data/exportaciones.xlsx")

imp <- read_excel("data/importaciones.xlsx")

bal <- read_excel("data/balanza_comercial.xlsx")


# Revisar nombres originales

names(exp)
names(imp)
names(bal)



# =====================================================
# 3. LIMPIEZA Y PREPARACIÓN DE DATOS
# =====================================================


# Cambiar nombres largos de variables

names(exp)[2] <- "exportaciones"

names(imp)[2] <- "importaciones"

names(bal)[2] <- "balanza_comercial"



# Unión de bases mediante Fecha

datos <- exp %>%
  left_join(imp, by="Fecha") %>%
  left_join(bal, by="Fecha")



# Revisar estructura

glimpse(datos)

head(datos)



# =====================================================
# 4. TRANSFORMACIÓN DE FECHA
# =====================================================


# Guardar fecha original

datos <- datos %>%
  mutate(
    Fecha_original = Fecha
  )



# Diccionario de meses

meses <- c(
  "Ene"="01",
  "Feb"="02",
  "Mar"="03",
  "Abr"="04",
  "May"="05",
  "Jun"="06",
  "Jul"="07",
  "Ago"="08",
  "Set"="09",
  "Sep"="09",
  "Oct"="10",
  "Nov"="11",
  "Dic"="12"
)



# Convertir fecha a formato Date

datos <- datos %>%
  mutate(
    mes = substr(Fecha,1,3),
    año = paste0("20",substr(Fecha,4,5)),
    
    Fecha = as.Date(
      paste(
        año,
        meses[mes],
        "01",
        sep="-"
      )
    )
  ) %>%
  select(-mes,-año)



head(datos)

class(datos$Fecha)



# =====================================================
# 5. CALIDAD DE DATOS
# =====================================================


# Valores perdidos

colSums(is.na(datos))


# Resumen general

summary(datos)


# Estadísticas completas

skim(datos)



# =====================================================
# 6. CREACIÓN DE VARIABLES
# =====================================================


# Variable que identifica superávit o déficit

datos <- datos %>%
  mutate(
    tipo_saldo = ifelse(
      balanza_comercial >=0,
      "Superávit",
      "Déficit"
    )
  )


table(datos$tipo_saldo)



# Frecuencia de saldos

saldo_frecuencia <- datos %>%
  count(tipo_saldo)


saldo_frecuencia
# =====================================================
# 7. ESTADÍSTICAS DESCRIPTIVAS
# =====================================================


estadisticas <- datos %>%
  summarise(
    
    # Exportaciones
    media_exportaciones = mean(exportaciones),
    mediana_exportaciones = median(exportaciones),
    desviacion_exportaciones = sd(exportaciones),
    minimo_exportaciones = min(exportaciones),
    maximo_exportaciones = max(exportaciones),
    
    
    # Importaciones
    media_importaciones = mean(importaciones),
    mediana_importaciones = median(importaciones),
    desviacion_importaciones = sd(importaciones),
    minimo_importaciones = min(importaciones),
    maximo_importaciones = max(importaciones),
    
    
    # Balanza comercial
    media_balanza = mean(balanza_comercial),
    mediana_balanza = median(balanza_comercial),
    desviacion_balanza = sd(balanza_comercial),
    mayor_superavit = max(balanza_comercial),
    mayor_deficit = min(balanza_comercial)
    
  )


estadisticas



# =====================================================
# 8. ANÁLISIS DE CORRELACIÓN
# =====================================================


correlacion <- datos %>%
  select(
    exportaciones,
    importaciones,
    balanza_comercial
  ) %>%
  cor()


correlacion



# Convertir matriz a formato largo

cor_largo <- as.data.frame(correlacion) %>%
  rownames_to_column("variable1") %>%
  pivot_longer(
    cols=-variable1,
    names_to="variable2",
    values_to="correlacion"
  )



# Gráfico matriz de correlación

grafico_matriz_cor <- ggplot(
  cor_largo,
  aes(
    x=variable1,
    y=variable2,
    fill=correlacion
  )
)+
  geom_tile()+
  geom_text(
    aes(label=round(correlacion,2))
  )+
  labs(
    title="Matriz de correlación del comercio exterior peruano",
    subtitle="Exportaciones, importaciones y balanza comercial",
    x="Variable",
    y="Variable",
    fill="Correlación"
  )+
  theme_minimal()



grafico_matriz_cor



